# Shared runtime
NODE_ENV=development
LOG_LEVEL=debug

# API Gateway
APP_NAME=Nexoraa CleanSoft
HOST=0.0.0.0
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Domain service template
SERVICE_NAME=auth-service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexoraa_cleansoft
MONGODB_DATABASE=nexoraa_cleansoft
MONGODB_PORT=27017

