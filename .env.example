# Shared runtime
NODE_ENV=development
LOG_LEVEL=debug

# Unified Auth Service / public HTTP entry point
APP_NAME=Nexoraa CleanSoft
HOST=0.0.0.0
PORT=3000
API_PREFIX=api
API_VERSION=v1
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-strong-access-token-secret
AUTH_REFRESH_TOKEN_SECRET=replace-with-a-different-strong-refresh-token-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_MAX_ACTIVE_SESSIONS=3
AUTH_ALLOW_MULTI_DEVICE=true

# Domain service template
SERVICE_NAME=tenant-service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/nexoraa_cleansoft
MONGODB_DATABASE=nexoraa_cleansoft
MONGODB_PORT=27017

# # Redis
# REDIS_URL=redis://localhost:6379
# REDIS_PORT=6379
