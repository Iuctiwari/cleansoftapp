# =============================================================================
# Nexoraa CleanSoft — Production Environment Variables Template
# =============================================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.
#
# Usage:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# =============================================================================

# ─── Global ───────────────────────────────────────────────────────────────────
NODE_ENV=production
TAG=latest                    # Docker image tag to deploy (e.g. v1.2.3 or git SHA)

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_PORT=27017
MONGODB_DATABASE=nexoraa_prod
MONGODB_ROOT_USERNAME=nexoraa_root      # admin credentials (production auth enabled)
MONGODB_ROOT_PASSWORD=CHANGE_ME         # use a strong random password
MONGODB_APP_USERNAME=nexoraa_app        # application credentials
MONGODB_APP_PASSWORD=CHANGE_ME

# Connection string used by all services
# Format: mongodb://user:pass@mongodb:27017/db?replicaSet=rs0&authSource=admin
MONGODB_URI=mongodb://nexoraa_app:CHANGE_ME@mongodb:27017/nexoraa_prod?replicaSet=rs0&authSource=admin

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME                # must match redis.conf requirepass
REDIS_URL=redis://:CHANGE_ME@redis:6379

# ─── API Gateway (@nexoraa/api-gateway) ───────────────────────────────────────
API_GATEWAY_PORT=3000
APP_NAME=Nexoraa CleanSoft
API_PREFIX=api
API_VERSION=v1

# JWT — generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_ISSUER=https://api.nexoraa.com
JWT_AUDIENCE=nexoraa-clients
JWT_ACCESS_TOKEN_SECRET=CHANGE_ME_64_CHAR_HEX_SECRET
JWT_REFRESH_TOKEN_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_HEX_SECRET
JWT_ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000     # 30 days

# Auth policy
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900                  # 15 min lockout
AUTH_OTP_TTL_SECONDS=300                  # 5 min OTP
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_ALLOW_MULTI_DEVICE=true

# ─── Auth Service (@nexoraa/auth-service) ─────────────────────────────────────
AUTH_SERVICE_PORT=3000
AUTH_SERVICE_NAME=auth-service

# ─── Tenant Service (@nexoraa/tenant-service) ─────────────────────────────────
TENANT_SERVICE_PORT=3000
TENANT_SERVICE_NAME=tenant-service

# ─── Branch Service (@nexoraa/branch-service) ─────────────────────────────────
BRANCH_SERVICE_PORT=3000
BRANCH_SERVICE_NAME=branch-service

# ─── User Service (@nexoraa/user-service) ─────────────────────────────────────
USER_SERVICE_PORT=3000
USER_SERVICE_NAME=user-service

# ─── Customer Service (@nexoraa/customer-service) ─────────────────────────────
CUSTOMER_SERVICE_PORT=3000
CUSTOMER_SERVICE_NAME=customer-service

# ─── Service Service (@nexoraa/service-service) ───────────────────────────────
SERVICE_SERVICE_PORT=3000
SERVICE_SERVICE_NAME=service-service

# ─── Order Service (@nexoraa/order-service) ───────────────────────────────────
ORDER_SERVICE_PORT=3000
ORDER_SERVICE_NAME=order-service

# ─── Payment Service (@nexoraa/payment-service) ───────────────────────────────
PAYMENT_SERVICE_PORT=3000
PAYMENT_SERVICE_NAME=payment-service

# ─── Expense Service (@nexoraa/expense-service) ───────────────────────────────
EXPENSE_SERVICE_PORT=3000
EXPENSE_SERVICE_NAME=expense-service

# ─── Notification Service (@nexoraa/notification-service) ─────────────────────
NOTIFICATION_SERVICE_PORT=3000
NOTIFICATION_SERVICE_NAME=notification-service

# ─── Scheduler Service (@nexoraa/scheduler-service) ──────────────────────────
SCHEDULER_SERVICE_PORT=3000
SCHEDULER_SERVICE_NAME=scheduler-service

# ─── Report Service (@nexoraa/report-service) ─────────────────────────────────
REPORT_SERVICE_PORT=3000
REPORT_SERVICE_NAME=report-service

# ─── Audit Service (@nexoraa/audit-service) ───────────────────────────────────
AUDIT_SERVICE_PORT=3000
AUDIT_SERVICE_NAME=audit-service

# ─── Search Service (@nexoraa/search-service) ─────────────────────────────────
SEARCH_SERVICE_PORT=3000
SEARCH_SERVICE_NAME=search-service

# ─── Nginx ────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Domain used in TLS certificates and server_name directive
DOMAIN=api.nexoraa.com
