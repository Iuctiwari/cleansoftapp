{
  "name": "@nexoraa/api-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Nexoraa CleanSoft NestJS backend foundation.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node -r ts-node/register src/main.ts",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "start:debug": "node --inspect --watch -r ts-node/register src/main.ts",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --no-error-on-unmatched-pattern",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.0",
    "@nestjs/microservices": "11.1.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nexoraa/config": "workspace:*",
    "@nexoraa/database": "workspace:*",
    "@nexoraa/swagger": "workspace:*",
    "bullmq": "^5.53.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.6.1",
    "mongoose": "^8.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
