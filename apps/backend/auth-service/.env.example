APP_NAME=Nexoraa CleanSoft
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=api
API_VERSION=v1
MONGODB_URI=mongodb://localhost:27017/nexoraa_dev

# Generate two different secrets containing at least 32 random characters each.
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-strong-access-token-secret
AUTH_REFRESH_TOKEN_SECRET=replace-with-a-different-strong-refresh-token-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_MAX_ACTIVE_SESSIONS=3
AUTH_ALLOW_MULTI_DEVICE=true
