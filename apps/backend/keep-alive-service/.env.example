NODE_ENV=development
PORT=10000

# How often to ping every configured target, in milliseconds. Render's free
# web-service inactivity timeout is 15 minutes; 120000 (2 minutes) keeps a
# wide safety margin.
KEEP_ALIVE_INTERVAL_MS=120000

# Per-target request timeout, in milliseconds. One slow/unreachable service
# can never block the others — each ping is aborted independently.
KEEP_ALIVE_REQUEST_TIMEOUT_MS=15000

# Max simultaneous in-flight pings. Kept at 4 (Node's default DNS
# thread-pool size) so concurrent lookups to many new hosts never queue long
# enough to trip the timeout above. Raise only alongside UV_THREADPOOL_SIZE.
KEEP_ALIVE_CONCURRENCY=4

# Set automatically by Render at runtime — do not set manually when
# deploying there. Used to self-ping so this service doesn't go idle either.
# RENDER_EXTERNAL_URL=https://keep-alive-service-xxxx.onrender.com

# Deployed (Render) base URLs — same keys as apps/mobile-app/.env, so values
# can be copied directly from there. A target is skipped if its var is unset.
RENDER_AUTH_API_BASE_URL=
RENDER_BRANCH_API_BASE_URL=
RENDER_CUSTOMER_API_BASE_URL=
RENDER_NOTIFICATION_API_BASE_URL=
RENDER_TENANT_API_BASE_URL=
RENDER_ORDER_API_BASE_URL=
RENDER_REPORT_API_BASE_URL=
RENDER_EXPENSE_API_BASE_URL=
RENDER_PAYMENT_API_BASE_URL=
RENDER_SERVICE_API_BASE_URL=
RENDER_USER_API_BASE_URL=
RENDER_SEARCH_API_BASE_URL=
RENDER_SETTINGS_API_BASE_URL=
RENDER_PLATFORM_ADMIN_API_BASE_URL=
# Not deployed with a known URL in apps/mobile-app/.env yet — fill in once
# known and this service starts pinging it automatically, no code change.
RENDER_AUDIT_API_BASE_URL=
RENDER_SCHEDULER_API_BASE_URL=
