{
  "name": "@nexoraa/keep-alive-service",
  "version": "0.0.0",
  "private": true,
  "description": "Pings every deployed Render service on an interval so free-tier instances don't spin down from inactivity.",
  "scripts": {
    "build": "node ../../../scripts/run-typescript-project.mjs build",
    "clean": "rimraf dist",
    "dev": "node ../../../scripts/run-typescript-project.mjs dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node ../../../scripts/run-typescript-project.mjs start",
    "start:prod": "node ../../../scripts/run-typescript-project.mjs start:prod",
    "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern",
    "typecheck": "node ../../../scripts/run-typescript-project.mjs typecheck"
  }
}
