{
  "name": "@nexoraa/report-service",
  "version": "0.0.0",
  "private": true,
  "description": "Report Service foundation.",
  "scripts": {
    "build": "node ../../../scripts/run-typescript-project.mjs build",
    "clean": "rimraf dist",
    "dev": "node ../../../scripts/run-typescript-project.mjs dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node ../../../scripts/run-typescript-project.mjs start",
    "start:prod": "node ../../../scripts/run-typescript-project.mjs start:prod",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --no-error-on-unmatched-pattern",
    "typecheck": "node ../../../scripts/run-typescript-project.mjs typecheck"
  },
  "dependencies": {
    "@nestjs/common": "11.1.0",
    "@nestjs/core": "11.1.0",
    "@nestjs/microservices": "11.1.0",
    "bullmq": "5.53.1",
    "ioredis": "5.6.1",
    "mongoose": "8.15.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
