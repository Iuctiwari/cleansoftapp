# auth-service — copy MONGODB_URI EXACTLY from Render -> auth-service (nexoraa-cleansoft-1) -> Environment.
# Each service uses its own database name; a wrong name looks like "all data is gone".
MONGODB_URI=FILL_ME
HOST=127.0.0.1
APP_NAME=Nexoraa CleanSoft
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_SECONDS=904800
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=3600
AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_MAX_ACTIVE_SESSIONS=3
AUTH_ALLOW_MULTI_DEVICE=true
# Email (OTP / password reset) via Brevo. The sender MUST be a verified sender in
# Brevo (Senders, Domains & Dedicated IPs) or every email is rejected.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contact@nexoraatech.com
BREVO_SENDER_NAME=Nexoraa
