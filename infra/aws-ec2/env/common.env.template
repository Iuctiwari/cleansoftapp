# Shared by EVERY service (loaded first; a service's own <name>.env wins on conflict).
# GENERATE_ME values are replaced with random secrets by setup-server.sh — because
# every service reads them from this one file, they always match each other.

# ── Internal service-to-service URLs (all on this same server) ──────────────
AUTH_SERVICE_BASE_URL=http://127.0.0.1:3001/api
AUTH_SERVICE_INTERNAL_URL=http://127.0.0.1:3001
BRANCH_SERVICE_BASE_URL=http://127.0.0.1:3002
CUSTOMER_SERVICE_BASE_URL=http://127.0.0.1:3003
NOTIFICATION_SERVICE_BASE_URL=http://127.0.0.1:3005
TENANT_SERVICE_BASE_URL=http://127.0.0.1:3006/api
ORDER_SERVICE_BASE_URL=http://127.0.0.1:3007/api
PAYMENT_SERVICE_BASE_URL=http://127.0.0.1:3010/api
SERVICE_SERVICE_BASE_URL=http://127.0.0.1:3012/api/v1
SERVICE_MANAGEMENT_BASE_URL=http://127.0.0.1:3012/api
USER_SERVICE_BASE_URL=http://127.0.0.1:3013/api
PLATFORM_ADMIN_SERVICE_BASE_URL=http://127.0.0.1:3015/api

# ── Shared internal secrets (auto-generated) ────────────────────────────────
# Changing AUTH_* secrets just signs everyone out once; nothing else is lost.
AUTH_ACCESS_TOKEN_SECRET=GENERATE_ME
AUTH_REFRESH_TOKEN_SECRET=GENERATE_ME
PLATFORM_ADMIN_ACCESS_TOKEN_SECRET=GENERATE_ME
PLATFORM_ADMIN_REFRESH_TOKEN_SECRET=GENERATE_ME
PLATFORM_ADMIN_INTERNAL_KEY=GENERATE_ME
PAYMENT_PROJECTION_KEY=GENERATE_ME
CATALOG_PROVISIONING_KEY=GENERATE_ME
INTERNAL_SERVICE_SECRET=GENERATE_ME
TENANT_ENFORCEMENT_SHARED_SECRET=GENERATE_ME

# Same as the Render deployment (plan/module enforcement off).
ENFORCE_TENANT_GUARDS=false
API_PREFIX=api
API_VERSION=v1
LOG_LEVEL=info
