{
  "name": "@nexoraa/logger",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable structured logging foundation for NestJS backend applications.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/run-typescript-project.mjs build",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\"",
    "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern",
    "typecheck": "node ../../scripts/run-typescript-project.mjs typecheck"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
