{
  "name": "@nexoraa/utils",
  "version": "0.0.0",
  "private": true,
  "description": "Pure framework-neutral utility and validation helpers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/run-typescript-project.mjs build",
    "clean": "rimraf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern",
    "typecheck": "node ../../scripts/run-typescript-project.mjs typecheck"
  }
}
